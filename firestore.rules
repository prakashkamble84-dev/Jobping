rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidCareerProfile(data) {
      return data.keys().hasAll(['uid', 'profileCompleted', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.profileCompleted is bool
        && data.createdAt is string
        && data.updatedAt is string
        && (!('skills' in data) || (data.skills is list && data.skills.size() <= 100))
        && (!('languages' in data) || (data.languages is list && data.languages.size() <= 30))
        && (!('targetJob' in data) || (data.targetJob is string && data.targetJob.size() <= 200))
        && (!('careerGoal' in data) || (data.careerGoal is string && data.careerGoal.size() <= 1000))
        && (!('careerObjective' in data) || (data.careerObjective is string && data.careerObjective.size() <= 2000));
    }

    // User accounts collection - private to owner
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket enumeration forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Career profiles collection - private to owner
    match /career_profiles/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket enumeration forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidCareerProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidCareerProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
